# DeepSeek (OpenAI-compatible). Required: real key from https://platform.deepseek.com (starts with sk-)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Vercel / cloud: Postgres (Neon or Supabase). Local Docker/start.bat can leave empty (SQLite).
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: extra CORS origins (comma-separated). *.vercel.app is always allowed.
# CORS_ORIGINS=https://your-custom-domain.com

# Optional: force serverless paths (/tmp data, MemorySaver) without VERCEL=1
# EXAM_AGENT_SERVERLESS=1

# Optional: path to KaiTi / STKaiti TTF (Windows default tried if unset)
KAITI_FONT_PATH=

# Optional: max knowledge points per generate_chunk_practice_pdfs_batch call (default 8)
# PRACTICE_BATCH_MAX_KNOWLEDGE_POINTS=8

# Optional: practice PDF — inline mathtext PNG for $...$ lines (default false)
# PRACTICE_PDF_INLINE_MATHTEXT=false
# Optional: write practice_*_figure_diag_practice.json / _answers.json next to exported PDFs
# PRACTICE_PDF_WRITE_FIGURE_DIAGNOSTICS=false

# LaTeX formula subsystem for practice PDF (default off). katex needs: pip install -e ".[latex]" && playwright install chromium
# On Vercel keep off — Playwright/Chromium are not available.
# PRACTICE_PDF_LATEX_RENDERER=off
# PRACTICE_PDF_LATEX_TIMEOUT_SEC=25
# PRACTICE_PDF_LATEX_CACHE_DIR=cache/formula_png
# PRACTICE_PDF_LATEX_DPI=160
# PRACTICE_PDF_LATEX_FALLBACK=flatten
# PRACTICE_PDF_LATEX_ROUTER_MIN_INNER_LEN=120
# PRACTICE_PDF_LATEX_ROUTER_MAX_BRACE_DEPTH=8
# PRACTICE_PDF_WRITE_FORMULA_DIAGNOSTICS=false
